; Engine configuration file.
config_version=5

[application]

config/name="Roze Koek Clicker"
config/description="Bak het grootste roze-koekenimperium ter wereld."
config/version="0.3.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(1, 0.913725, 0.945098, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameData="*res://autoload/game_data.gd"
GameState="*res://autoload/game_state.gd"
Economy="*res://autoload/economy.gd"
UpgradeSystem="*res://autoload/upgrade_system.gd"
CharacterSystem="*res://autoload/character_system.gd"
RandomEventSystem="*res://autoload/random_event_system.gd"
ProductionSystem="*res://autoload/production_system.gd"
ClickSystem="*res://autoload/click_system.gd"
PrestigeSystem="*res://autoload/prestige_system.gd"
HeavenSystem="*res://autoload/heaven_system.gd"
AchievementSystem="*res://autoload/achievement_system.gd"
ChallengeSystem="*res://autoload/challenge_system.gd"
SaveManager="*res://autoload/save_manager.gd"
OfflineSystem="*res://autoload/offline_system.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(1, 0.913725, 0.945098, 1)
anti_aliasing/quality/msaa_2d=1
